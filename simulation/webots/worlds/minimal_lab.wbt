DEF DRONE BlindDrone { translation -4 0 1.5 customData "{\"vehicle\":{\"mass_kg\":1.0,\"body_size_m\":[0.6,0.6,0.16],\"inertia_kg_m2\":[0.03,0.03,0.05],\"arm_offset_m\":0.25,\"thrust_coefficient_n_s2\":1e-05,\"torque_to_thrust_m\":0.02,\"motor_max_rad_s\":1000.0,\"motor_acceleration_rad_s2\":10000.0,\"motor_max_torque_nm\":10000.0,\"actuator_assumption\":\"fast ideal velocity actuator; authority limits are not real motor ratings\",\"horizontal_speed_m_s\":0.8,\"vertical_speed_m_s\":0.4,\"yaw_rate_rad_s\":0.5,\"altitude_bounds_m\":[0.4,5.0]},\"control\":{\"velocity_gain_s_inv\":1.8,\"acceleration_limit_m_s2\":2.0,\"tilt_limit_rad\":0.22,\"altitude_p_s_inv2\":5.0,\"altitude_d_s_inv\":3.5,\"attitude_p_nm_rad\":0.45,\"attitude_d_nm_s_rad\":0.18,\"yaw_p_nm_rad\":0.25,\"yaw_d_nm_s_rad\":0.14},\"sensors\":{\"model\":\"geometric_single_ray_generic_distance_sensor\",\"range_max_m\":8.0,\"horizontal_directions_deg\":[0.0,45.0,90.0,135.0,180.0,225.0,270.0,315.0],\"horizontal_origin_radius_m\":0.33,\"vertical_origin_offset_m\":0.12,\"noise_fraction\":0.0,\"latency_s\":0.0,\"localization\":\"Webots GPS, ideal local Cartesian coordinates\",\"attitude\":\"Webots InertialUnit, ideal simulator attitude; no fusion model\",\"angular_velocity\":\"Webots Gyro, ideal\"},\"world\":{\"gravity_m_s2\":9.81},\"sensor_period_ms\":32,\"goal_m\":[5.0,4.0,1.5],\"sensor_names\":[\"range_000\",\"range_045\",\"range_090\",\"range_135\",\"range_180\",\"range_225\",\"range_270\",\"range_315\",\"range_up\",\"range_down\"]}" }
